#!/usr/bin/env python3
"""
GPT Quant V9.2 Paper Trading Phase 3.4.2.1
Market State Persistence Fix v2
Schema Compatibility Hotfix

Fix:
- Never assumes gptq_paper_daily_snapshots has latest_market_date/market_stale_days.
- Snapshot query only reads stable qualification fields.
- Market date is resolved independently from market-data tables.
- market_stale_days is computed in Python.
- Fail-closed safety remains enforced.
"""

from __future__ import annotations

import json
import os
import urllib.error
import urllib.parse
import urllib.request
from datetime import date, datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
OUT = ROOT / "phase3421_output"
OUT.mkdir(exist_ok=True)

SUPABASE_URL = os.environ["SUPABASE_URL"].rstrip("/")
SUPABASE_KEY = os.environ["SUPABASE_SERVICE_ROLE_KEY"]

STRATEGY = os.getenv("PAPER_STRATEGY_VERSION", "V9.1")
MODE = "SHADOW_ONLY_NO_BROKER"
REQUIRED_PASS_DAYS = int(os.getenv("PHASE3421_REQUIRED_PASS_DAYS", "5"))

SNAPSHOT_TABLE = os.getenv("PHASE3421_SNAPSHOT_TABLE", "gptq_paper_daily_snapshots")

MARKET_CANDIDATES = [
    ("gpt_quant_v9_market_data", "trade_date"),
    ("gptq_market_prices", "trade_date"),
    ("market_prices", "trade_date"),
    ("gpt_quant_market_data", "trade_date"),
]

def now_iso():
    return datetime.now(timezone.utc).isoformat()

def request_get(table: str, params: dict):
    q = urllib.parse.urlencode(params, doseq=True)
    url = f"{SUPABASE_URL}/rest/v1/{table}?{q}"

    headers = {
        "apikey": SUPABASE_KEY,
        "Authorization": f"Bearer {SUPABASE_KEY}",
        "Accept": "application/json",
    }

    req = urllib.request.Request(url, headers=headers, method="GET")

    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            raw = r.read().decode("utf-8")
            return json.loads(raw) if raw else []
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(
            f"Supabase GET {table}: HTTP {exc.code}: {body}"
        ) from exc

def first_dict(v):
    if isinstance(v, dict):
        return v
    if isinstance(v, list):
        for item in v:
            if isinstance(item, dict):
                return item
    return None

def parse_date(value):
    if not value:
        return None
    return date.fromisoformat(str(value)[:10])

def resolve_latest_market_date():
    errors = []

    for table, field in MARKET_CANDIDATES:
        try:
            rows = request_get(
                table,
                {
                    "select": field,
                    "order": f"{field}.desc",
                    "limit": "1",
                },
            )
            row = first_dict(rows)
            if row and row.get(field):
                return str(row[field])[:10], table, field, errors
        except Exception as exc:
            errors.append(f"{table}.{field}: {exc}")

    return None, None, None, errors

def load_snapshot_rows():
    # v2 deliberately requests ONLY stable snapshot fields.
    params = {
        "select": "run_date,status,strategy_version,mode",
        "strategy_version": f"eq.{STRATEGY}",
        "order": "run_date.desc",
        "limit": "60",
    }
    rows = request_get(SNAPSHOT_TABLE, params)
    return rows if isinstance(rows, list) else []

def distinct_daily_rows(rows):
    seen = set()
    out = []

    for row in rows:
        if not isinstance(row, dict):
            continue
        rd = str(row.get("run_date") or "")[:10]
        if not rd or rd in seen:
            continue
        seen.add(rd)
        out.append(row)

    return out

def consecutive_pass_days(rows):
    ordered = distinct_daily_rows(rows)

    streak = 0
    dates = []

    for row in ordered:
        mode = row.get("mode")
        if mode is not None and str(mode) != MODE:
            break

        status = str(row.get("status") or "").upper()
        if status != "PASS":
            break

        streak += 1
        dates.append(str(row.get("run_date"))[:10])

    return streak, dates

def main():
    if MODE != "SHADOW_ONLY_NO_BROKER":
        raise RuntimeError("Safety lock violation")

    market_date, market_table, market_field, market_errors = resolve_latest_market_date()

    if not market_date:
        raise RuntimeError(
            "Unable to resolve latest_market_date. "
            + (" | ".join(market_errors) if market_errors else "")
        )

    market_dt = parse_date(market_date)
    if market_dt is None:
        raise RuntimeError("Invalid latest_market_date")

    stale_days = (date.today() - market_dt).days

    rows = load_snapshot_rows()
    pass_days, streak_dates = consecutive_pass_days(rows)

    result = {
        "version": "3.4.2.1-v2",
        "checked_at": now_iso(),
        "status": "PASS",
        "strategy_version": STRATEGY,
        "trading_mode": MODE,
        "pass_day_source": "distinct_run_date_snapshot_status",
        "snapshot_table": SNAPSHOT_TABLE,
        "snapshot_rows_scanned": len(rows),
        "consecutive_pass_days": pass_days,
        "required_pass_days": REQUIRED_PASS_DAYS,
        "remaining_pass_days": max(REQUIRED_PASS_DAYS - pass_days, 0),
        "streak_dates": streak_dates,
        "latest_market_date": market_date,
        "market_stale_days": stale_days,
        "market_source_table": market_table,
        "market_source_field": market_field,
        "market_source_errors": market_errors,
        "human_approval_required": True,
        "automatic_approval": False,
        "broker_trading_enabled": False,
        "real_money_trading_enabled": False,
        "release_state": "LOCKED",
        "fail_closed": True,
    }

    (OUT / "market_state.json").write_text(
        json.dumps(result, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )

    compat = ROOT / "phase342_output"
    compat.mkdir(exist_ok=True)

    (compat / "phase342_market_state.json").write_text(
        json.dumps(result, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )

    summary = [
        "# GPT Quant V9.2 Paper Trading - Phase 3.4.2.1 v2",
        "",
        "## Market State Persistence Fix - Schema Compatibility Hotfix",
        "",
        f"- Status: **{result['status']}**",
        f"- Strategy: `{STRATEGY}`",
        f"- Trading Mode: `{MODE}`",
        f"- PASS-day Source: `{result['pass_day_source']}`",
        f"- Snapshot table: `{SNAPSHOT_TABLE}`",
        f"- Snapshot rows scanned: **{len(rows)}**",
        f"- Consecutive PASS days: **{pass_days} / {REQUIRED_PASS_DAYS}**",
        f"- Remaining PASS days: **{result['remaining_pass_days']}**",
        f"- Latest market date: `{market_date}`",
        f"- Market stale days: `{stale_days}`",
        f"- Market source: `{market_table}.{market_field}`",
        "",
        "### Safety Locks",
        "",
        "- Human approval required: **YES**",
        "- Automatic approval: **DISABLED**",
        "- Release State: **LOCKED**",
        "- Broker trading: **DISABLED**",
        "- Real-money trading: **DISABLED**",
        "- Missing/incompatible source data => **BLOCKED / FAIL-CLOSED**",
    ]

    (OUT / "market_state.md").write_text(
        "\n".join(summary) + "\n",
        encoding="utf-8",
    )

    gh = os.getenv("GITHUB_STEP_SUMMARY")
    if gh:
        with open(gh, "a", encoding="utf-8") as f:
            f.write("\n".join(summary) + "\n")

    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 0

if __name__ == "__main__":
    raise SystemExit(main())