#!/usr/bin/env python3
"""
GPT Quant V9.2 Paper Trading Phase 3.4.2.1
Market State Persistence Fix v3
Canonical Market Source Discovery

Goals:
- Stop guessing one fixed Supabase market table.
- Discover latest_market_date from canonical local outputs first.
- Fall back to safe Supabase discovery only when needed.
- Preserve qualification PASS-day streak from gptq_paper_daily_snapshots.
- Remain fail-closed and SHADOW_ONLY_NO_BROKER.
"""

from __future__ import annotations

import json
import os
import re
import urllib.error
import urllib.parse
import urllib.request
from datetime import date, datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
OUT = ROOT / "phase3421_output"
OUT.mkdir(exist_ok=True)

SUPABASE_URL = os.environ["SUPABASE_URL"].rstrip("/")
SUPABASE_KEY = os.environ["SUPABASE_SERVICE_ROLE_KEY"]

STRATEGY = os.getenv("PAPER_STRATEGY_VERSION", "V9.1")
MODE = "SHADOW_ONLY_NO_BROKER"
REQUIRED_PASS_DAYS = int(os.getenv("PHASE3421_REQUIRED_PASS_DAYS", "5"))
SNAPSHOT_TABLE = os.getenv("PHASE3421_SNAPSHOT_TABLE", "gptq_paper_daily_snapshots")

LOCAL_JSON_CANDIDATES = [
    ROOT / "phase21_output" / "signal_generation.json",
    ROOT / "phase21_output" / "market_state.json",
    ROOT / "phase21_output" / "summary.json",
    ROOT / "phase21_result.json",
    ROOT / "phase21_summary.json",
    ROOT / "market_data_output" / "summary.json",
    ROOT / "market_data_output" / "market_state.json",
    ROOT / "phase342_output" / "phase342_market_state.json",
]

SEARCH_DIRS = [
    ROOT / "phase21_output",
    ROOT / "market_data_output",
    ROOT / "evidence",
    ROOT,
]

TABLE_CANDIDATES = [
    ("gptq_market_data", "trade_date"),
    ("gptq_daily_prices", "trade_date"),
    ("gptq_market_daily", "trade_date"),
    ("gptq_prices", "trade_date"),
    ("gptq_stock_prices", "trade_date"),
    ("gpt_quant_v92_market_data", "trade_date"),
    ("gpt_quant_market_prices", "trade_date"),
    ("market_data", "trade_date"),
]

DATE_KEYS = (
    "latest_market_date",
    "market_date",
    "latest_trade_date",
    "trade_date",
)

STATUS_KEYS = (
    "market_data_status",
    "market_status",
    "status",
)

def now_iso():
    return datetime.now(timezone.utc).isoformat()

def request_get(table: str, params: dict):
    q = urllib.parse.urlencode(params, doseq=True)
    url = f"{SUPABASE_URL}/rest/v1/{table}?{q}"
    headers = {
        "apikey": SUPABASE_KEY,
        "Authorization": f"Bearer {SUPABASE_KEY}",
        "Accept": "application/json",
    }
    req = urllib.request.Request(url, headers=headers, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            raw = r.read().decode("utf-8")
            return json.loads(raw) if raw else []
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(
            f"Supabase GET {table}: HTTP {exc.code}: {body}"
        ) from exc

def parse_date(value):
    if not value:
        return None
    s = str(value)[:10]
    try:
        return date.fromisoformat(s)
    except Exception:
        return None

def recursive_find_date(obj):
    if isinstance(obj, dict):
        for key in DATE_KEYS:
            if key in obj and parse_date(obj.get(key)):
                return str(obj.get(key))[:10], key
        for value in obj.values():
            found = recursive_find_date(value)
            if found:
                return found
    elif isinstance(obj, list):
        for item in obj:
            found = recursive_find_date(item)
            if found:
                return found
    return None

def recursive_find_status(obj):
    if isinstance(obj, dict):
        for key in STATUS_KEYS:
            if key in obj and obj.get(key) is not None:
                val = str(obj.get(key))
                if val.upper() in ("FRESH", "PASS", "OK", "HEALTHY"):
                    return val, key
        for value in obj.values():
            found = recursive_find_status(value)
            if found:
                return found
    elif isinstance(obj, list):
        for item in obj:
            found = recursive_find_status(item)
            if found:
                return found
    return None

def load_json_file(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None

def discover_from_local():
    attempts = []

    # 1. Known likely outputs.
    for path in LOCAL_JSON_CANDIDATES:
        if not path.exists():
            continue
        data = load_json_file(path)
        if data is None:
            attempts.append(f"{path}:invalid_json")
            continue

        d = recursive_find_date(data)
        if d:
            st = recursive_find_status(data)
            return {
                "latest_market_date": d[0],
                "source": str(path.relative_to(ROOT)),
                "source_kind": "local_json",
                "date_key": d[1],
                "status": st[0] if st else None,
                "status_key": st[1] if st else None,
                "attempts": attempts,
            }
        attempts.append(f"{path}:no_date")

    # 2. Broad JSON discovery by filenames/content.
    seen = set()
    for base in SEARCH_DIRS:
        if not base.exists():
            continue

        for path in base.rglob("*.json"):
            try:
                rel = str(path.relative_to(ROOT))
            except Exception:
                rel = str(path)

            if rel in seen:
                continue
            seen.add(rel)

            low = path.name.lower()
            if not any(token in low for token in ("market", "signal", "phase21", "summary", "evidence", "state")):
                continue

            data = load_json_file(path)
            if data is None:
                continue

            d = recursive_find_date(data)
            if d:
                st = recursive_find_status(data)
                return {
                    "latest_market_date": d[0],
                    "source": rel,
                    "source_kind": "discovered_local_json",
                    "date_key": d[1],
                    "status": st[0] if st else None,
                    "status_key": st[1] if st else None,
                    "attempts": attempts,
                }

    # 3. Markdown/text summary fallback.
    pattern = re.compile(
        r"(latest[_ ]market[_ ]date|latest[_ ]trade[_ ]date|market[_ ]date)\s*[:=]\s*`?(\d{4}-\d{2}-\d{2})",
        re.IGNORECASE,
    )

    for base in SEARCH_DIRS:
        if not base.exists():
            continue
        for ext in ("*.md", "*.txt", "*.log"):
            for path in base.rglob(ext):
                try:
                    text = path.read_text(encoding="utf-8", errors="ignore")
                except Exception:
                    continue
                m = pattern.search(text)
                if m:
                    try:
                        rel = str(path.relative_to(ROOT))
                    except Exception:
                        rel = str(path)
                    return {
                        "latest_market_date": m.group(2),
                        "source": rel,
                        "source_kind": "local_text",
                        "date_key": m.group(1),
                        "status": None,
                        "status_key": None,
                        "attempts": attempts,
                    }

    return None

def discover_from_supabase():
    errors = []

    for table, field in TABLE_CANDIDATES:
        try:
            rows = request_get(
                table,
                {
                    "select": field,
                    "order": f"{field}.desc",
                    "limit": "1",
                },
            )
            if isinstance(rows, list) and rows:
                row = rows[0]
                if isinstance(row, dict) and parse_date(row.get(field)):
                    return {
                        "latest_market_date": str(row[field])[:10],
                        "source": f"{table}.{field}",
                        "source_kind": "supabase",
                        "date_key": field,
                        "status": None,
                        "status_key": None,
                        "attempts": errors,
                    }
        except Exception as exc:
            errors.append(f"{table}.{field}: {exc}")

    return {
        "latest_market_date": None,
        "source": None,
        "source_kind": "supabase_failed",
        "date_key": None,
        "status": None,
        "status_key": None,
        "attempts": errors,
    }

def load_snapshot_rows():
    # Stable schema only.
    params = {
        "select": "run_date,status,strategy_version,mode",
        "strategy_version": f"eq.{STRATEGY}",
        "order": "run_date.desc",
        "limit": "60",
    }
    rows = request_get(SNAPSHOT_TABLE, params)
    return rows if isinstance(rows, list) else []

def distinct_daily_rows(rows):
    seen = set()
    out = []

    for row in rows:
        if not isinstance(row, dict):
            continue

        run_date = str(row.get("run_date") or "")[:10]
        if not run_date or run_date in seen:
            continue

        seen.add(run_date)
        out.append(row)

    return out

def consecutive_pass_days(rows):
    streak = 0
    dates = []

    for row in distinct_daily_rows(rows):
        mode = row.get("mode")
        if mode is not None and str(mode) != MODE:
            break

        if str(row.get("status") or "").upper() != "PASS":
            break

        streak += 1
        dates.append(str(row.get("run_date"))[:10])

    return streak, dates

def main():
    if MODE != "SHADOW_ONLY_NO_BROKER":
        raise RuntimeError("Safety lock violation")

    local = discover_from_local()
    market = local if local else discover_from_supabase()

    market_date = market.get("latest_market_date") if market else None
    if not market_date:
        details = market.get("attempts", []) if market else []
        raise RuntimeError(
            "Unable to resolve latest market date from canonical local outputs "
            "or Supabase discovery. " + " | ".join(details)
        )

    md = parse_date(market_date)
    if md is None:
        raise RuntimeError(f"Invalid latest_market_date: {market_date}")

    stale_days = (date.today() - md).days

    rows = load_snapshot_rows()
    pass_days, streak_dates = consecutive_pass_days(rows)

    result = {
        "version": "3.4.2.1-v3",
        "checked_at": now_iso(),
        "status": "PASS",
        "strategy_version": STRATEGY,
        "trading_mode": MODE,
        "pass_day_source": "distinct_run_date_snapshot_status",
        "snapshot_table": SNAPSHOT_TABLE,
        "snapshot_rows_scanned": len(rows),
        "consecutive_pass_days": pass_days,
        "required_pass_days": REQUIRED_PASS_DAYS,
        "remaining_pass_days": max(REQUIRED_PASS_DAYS - pass_days, 0),
        "streak_dates": streak_dates,
        "latest_market_date": market_date,
        "market_stale_days": stale_days,
        "market_source": market.get("source"),
        "market_source_kind": market.get("source_kind"),
        "market_status": market.get("status"),
        "market_discovery_attempts": market.get("attempts", []),
        "human_approval_required": True,
        "automatic_approval": False,
        "broker_trading_enabled": False,
        "real_money_trading_enabled": False,
        "release_state": "LOCKED",
        "fail_closed": True,
    }

    (OUT / "market_state.json").write_text(
        json.dumps(result, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )

    compat = ROOT / "phase342_output"
    compat.mkdir(exist_ok=True)
    (compat / "phase342_market_state.json").write_text(
        json.dumps(result, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )

    summary = [
        "# GPT Quant V9.2 Paper Trading - Phase 3.4.2.1 v3",
        "",
        "## Canonical Market Source Discovery",
        "",
        f"- Status: **{result['status']}**",
        f"- Strategy: `{STRATEGY}`",
        f"- Trading Mode: `{MODE}`",
        f"- PASS-day Source: `{result['pass_day_source']}`",
        f"- Consecutive PASS days: **{pass_days} / {REQUIRED_PASS_DAYS}**",
        f"- Remaining PASS days: **{result['remaining_pass_days']}**",
        f"- Latest market date: `{market_date}`",
        f"- Market stale days: `{stale_days}`",
        f"- Market source: `{result['market_source']}`",
        f"- Market source kind: `{result['market_source_kind']}`",
        f"- Market status: `{result['market_status']}`",
        f"- Snapshot rows scanned: **{len(rows)}**",
        "",
        "### Safety Locks",
        "",
        "- Release State: **LOCKED**",
        "- Human approval required: **YES**",
        "- Automatic approval: **DISABLED**",
        "- Broker trading: **DISABLED**",
        "- Real-money trading: **DISABLED**",
        "- Missing/inconsistent source data => **BLOCKED / FAIL-CLOSED**",
    ]

    (OUT / "market_state.md").write_text(
        "\n".join(summary) + "\n",
        encoding="utf-8",
    )

    gh = os.getenv("GITHUB_STEP_SUMMARY")
    if gh:
        with open(gh, "a", encoding="utf-8") as f:
            f.write("\n".join(summary) + "\n")

    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 0

if __name__ == "__main__":
    raise SystemExit(main())