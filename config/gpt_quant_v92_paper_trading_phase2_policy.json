{
  "version": "1.0",
  "mode": "SHADOW_ONLY_NO_BROKER",
  "real_order_execution": false,
  "features": [
    "live daily signal scan from Supabase daily_prices",
    "paper entry orders",
    "daily mark-to-market",
    "stop loss exits",
    "take profit exits",
    "trailing stop exits",
    "max holding day exits",
    "realized/unrealized P&L",
    "gross exposure cap",
    "single position cap",
    "risk event logging",
    "dashboard compatible paper tables"
  ],
  "defaults": {
    "initial_capital": 1000000,
    "score_threshold": 65,
    "position_size": 0.1,
    "max_new_orders": 5,
    "max_open_positions": 10,
    "max_gross_exposure": 0.8,
    "max_single_position": 0.15,
    "stop_loss": 0.05,
    "take_profit": 0.1,
    "max_holding_days": 10,
    "trailing_stop": 0.06
  }
}
