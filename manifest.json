      "paper_only": true,
      "human_approval_required": true
    }
  },
  "files": [
    "automation/enterprise572_promotion_eligibility_engine.py",
    ".github/workflows/enterprise-5-7-2-promotion-eligibility.yml",
    "supabase/ENTERPRISE_5_7_2_PROMOTION_ELIGIBILITY_VERIFY.sql",
